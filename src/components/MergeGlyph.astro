---
/* Deux carrés (deux marques) qui fusionnent en un seul (un datalayer commun).
   Occupe la même hauteur qu'un .metric__value pour aligner les cartes. */
---

<div class="glyph" role="img" aria-label="Deux systèmes de tracking fusionnés en un seul">
  <svg viewBox="0 0 96 40" aria-hidden="true">
    <rect class="sq" x="1.5" y="9" width="22" height="22" rx="4" />
    <rect class="sq sq--b" x="27.5" y="9" width="22" height="22" rx="4" />
    <path class="arrow" d="M56 20h11" />
    <path class="arrow" d="M63 15.5l4.5 4.5-4.5 4.5" />
    <rect class="sq sq--merged" x="72.5" y="9" width="22" height="22" rx="4" />
  </svg>
</div>

<style>
  .glyph {
    display: flex;
    align-items: center;
    height: clamp(1.9rem, 4vw, 2.5rem);
    margin-bottom: 0.6rem;
  }

  svg {
    height: 100%;
    width: auto;
    overflow: visible;
  }

  .sq {
    fill: var(--white);
    stroke: var(--ink);
    stroke-width: 2.5;
  }

  .sq--b {
    fill: var(--yellow);
  }

  .sq--merged {
    fill: var(--yellow);
  }

  .arrow {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
