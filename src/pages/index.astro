---
import Layout from '../layouts/Layout.astro';
import MergeGlyph from '../components/MergeGlyph.astro';
import { profile, metrics, timeline, beliefs, stack, project } from '../data/content';
---

<Layout
  title="Anthony Roque - Growth Marketer à Bordeaux"
  description="Growth Marketer à Bordeaux. 2M€+ de budget media piloté, 0 à 100k€ d'ARR sur un SaaS B2B, tout ça tout ça, téma la meta desc"
>
  <main>
    <!-- HERO -->
    <header class="hero">
      <div class="wrap hero__grid">
        <div class="hero__text">
          <h1>Anthony<br />Roque</h1>
          <p class="hero__tagline">{profile.tagline}</p>
          <div class="hero__actions">
            <a class="btn btn--primary" href={profile.linkedin} target="_blank" rel="noopener">
              Mon LinkedIn ↗
            </a>
            <a class="btn" href={`mailto:${profile.email}`}>M'écrire</a>
          </div>
        </div>

        <div class="hero__photo">
          <a
            class="photo-frame block block--yellow"
            href={profile.cv}
            download
            aria-label="Télécharger mon CV"
          >
            <span class="photo-flip">
              <span class="photo-face photo-face--front">
                <img
                  src={profile.photo}
                  alt="Portrait d'Anthony Roque"
                  width="600"
                  height="600"
                  fetchpriority="high"
                />
              </span>
              <span class="photo-face photo-face--back">
                <span class="photo-face__text">Clic pour télécharger mon CV</span>
              </span>
            </span>
          </a>
        </div>
      </div>
    </header>

    <!-- METRICS -->
    <section id="chiffres" aria-labelledby="chiffres-title">
      <div class="wrap">
        <h2 id="chiffres-title" class="section-title"><span>Les plus gros impacts</span></h2>
        <ul class="metrics">
          {
            metrics.map((m) => (
              <li class="metric block">
                {m.visual === 'merge' ? (
                  <MergeGlyph />
                ) : (
                  <p class="metric__value">{m.value}</p>
                )}
                <p class="metric__label">{m.label}</p>
                <p class="metric__detail">{m.detail}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- TIMELINE -->
    <section id="parcours" aria-labelledby="parcours-title">
      <div class="wrap">
        <h2 id="parcours-title" class="section-title">
          <span>Le parcours</span>
        </h2>
        <ol class="timeline">
          {
            timeline.map((job, i) => (
              <li class="job-item">
                <button
                  type="button"
                  class="job block push"
                  data-job-index={i}
                  aria-haspopup="dialog"
                >
                  <div class="job__head">
                    <div>
                      <h3 class="job__company">
                        {job.company}
                        {job.current && <em class="job__badge">en cours</em>}
                      </h3>
                      <p class="job__role">
                        {job.role} · {job.context}
                      </p>
                    </div>
                    <p class="job__period">{job.period}</p>
                  </div>
                  <p class="job__punchline">{job.punchline}</p>
                  <span class="job__more" aria-hidden="true">Voir le détail →</span>
                </button>
              </li>
            ))
          }
        </ol>

        <dialog class="job-modal" id="job-modal" aria-labelledby="job-modal-title">
          <div class="job-modal__inner">
            <button type="button" class="job-modal__close" aria-label="Fermer">×</button>
            <header class="job-modal__head">
              <h3 id="job-modal-title" class="job-modal__title" />
              <p class="job-modal__meta" />
            </header>
            <dl class="job-modal__facts" />
            <div class="job-modal__actions-block">
              <p class="job-modal__actions-title">Actions / projets</p>
              <ul class="job-modal__actions" />
            </div>
          </div>
        </dialog>

        <script is:inline define:vars={{ timeline }}>
          window.__timelineData = timeline;
        </script>
      </div>
    </section>

    <!-- BELIEFS -->
    <section id="convictions" aria-labelledby="convictions-title">
      <div class="wrap">
        <h2 id="convictions-title" class="section-title"><span>Trois convictions</span></h2>
        <ul class="beliefs">
          {
            beliefs.map((b, i) => (
              <li class="belief block block--ink">
                <span class="belief__num" aria-hidden="true">
                  0{i + 1}
                </span>
                <h3 class="belief__title">{b.title}</h3>
                <p class="belief__body">{b.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- STACK -->
    <section id="stack" aria-labelledby="stack-title">
      <div class="wrap">
        <h2 id="stack-title" class="section-title"><span>La boîte à outils</span></h2>
        <dl class="stack">
          {
            stack.map((group) => (
              <div class="stack__group">
                <dt class="stack__label">{group.group}</dt>
                <dd>
                  <ul class="chips">
                    {group.tools.map((tool) => (
                      <li class="chip">{tool}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- PROJECT -->
    <section id="projet" aria-labelledby="projet-title">
      <div class="wrap">
        <h2 id="projet-title" class="section-title"><span>{project.title}</span></h2>

        <figure class="projet__banner block block--yellow">
          <img
            src={project.image}
            alt={project.imageAlt}
            width="1920"
            height="1080"
            loading="lazy"
          />
        </figure>

        <div class="projet__grid">
          <div class="projet__col">
            <article class="projet-card block">
              <p class="projet-card__kicker">01 · Pourquoi</p>
              <p class="projet-card__body">{project.why}</p>
            </article>

            <article class="projet-card block">
              <p class="projet-card__kicker">02 · Objectifs</p>
              <ol class="projet-card__goals">
                {project.goals.map((g) => <li>{g}</li>)}
              </ol>
            </article>
          </div>

          <article class="projet-card projet-card--workflow block block--ink">
            <p class="projet-card__kicker projet-card__kicker--ink">03 · Workflow de contenu SEO</p>
            <p class="projet-card__intro">{project.workflow.intro}</p>
            <ol class="projet-card__steps">
              {project.workflow.steps.map((s) => <li>{s}</li>)}
            </ol>
            <p class="projet-card__outro">
              Pour faire rédiger des articles de qualité, j'ai mis en place une base de connaissance
              complète de +80 fichiers ainsi qu'une base de +30 cas clients (fichiers .md pour
              faciliter le flow). Chaque article se base sur les fichiers pertinents selon le sujet
              et <strong>chaque résultat est unique et impossible à dupliquer par quelqu'un d'autre.</strong>
            </p>
          </article>
        </div>

        <div class="projet__cta">
          <a class="btn btn--primary" href="https://kind-dog-training.fr/" target="_blank" rel="noopener">
            Voir le site ↗
          </a>
        </div>
      </div>
    </section>

    <!-- ABOUT -->
    <section id="perso" aria-labelledby="perso-title">
      <div class="wrap">
        <h2 id="perso-title" class="section-title"><span>En savoir un peu plus sur moi</span></h2>
        <div class="about block">
          <p class="about__body">
            J'adore les animaux (j'ai un chat et un chien) et en dehors du boulot j'aime passer du
            temps à la salle de sport car je suis passionné de bodybuilding. J'ai même concouru en
            Belgique et en France en 2024 (expérience très fatigante mais j'en suis assez fier).
            J'adore les randonnées en montagne et avec ma compagne nous avons pour projet d'acquérir
            un fourgon aménagé pour davantage profiter de ce type de paysages.
          </p>
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" aria-labelledby="contact-title">
      <div class="wrap">
        <div class="contact block block--yellow">
          <h2 id="contact-title" class="contact__title">On en parle ?</h2>
          <p class="contact__body">
            Je cherche un poste en Growth. Si vous avez besoin de scaler votre activité, mettre en
            place un système d'acquisition et d'activation de 0 et que vous ne voulez plus raisonner
            en "campagnes" mais en système, parlons en :)
          </p>
          <div class="hero__actions">
            <a class="btn" href={`mailto:${profile.email}`}>{profile.email}</a>
            <a class="btn" href={profile.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap">
      <p>© {new Date().getFullYear()} Anthony Roque · {profile.location}</p>
    </div>
  </footer>
</Layout>

<script>
  // Easter egg console (pour les curieux qui ouvrent les devtools).
  console.log(
    '%cTu inspectes la console ? On va bien s\'entendre :)',
    'background:#252525;color:#ffc700;font-weight:700;padding:8px 14px;border-radius:8px;font-size:13px;'
  );

  // Faux "tracking event" (clin d'œil growth) : petite pastille de log, une fois par event.
  const tracked = new Set();
  let trackerLayer = null;

  const track = (name, { once = true } = {}) => {
    if (once) {
      if (tracked.has(name)) return;
      tracked.add(name);
    }

    if (!trackerLayer) {
      trackerLayer = document.createElement('div');
      trackerLayer.className = 'tracker';
      document.body.appendChild(trackerLayer);
    }

    const toast = document.createElement('div');
    toast.className = 'tracker__toast';
    toast.setAttribute('role', 'status');

    const label = document.createElement('span');
    label.className = 'tracker__label';
    label.textContent = 'event tracked';

    const evt = document.createElement('span');
    evt.className = 'tracker__event';
    evt.textContent = `${name} ✅`;

    toast.append(label, evt);
    trackerLayer.appendChild(toast);

    setTimeout(() => {
      toast.classList.add('is-leaving');
      setTimeout(() => toast.remove(), 260);
    }, 2600);
  };

  // Popup détails parcours
  const jobModal = document.getElementById('job-modal');
  if (jobModal) {
    const titleEl = jobModal.querySelector('.job-modal__title');
    const metaEl = jobModal.querySelector('.job-modal__meta');
    const factsEl = jobModal.querySelector('.job-modal__facts');
    const actionsEl = jobModal.querySelector('.job-modal__actions');
    const closeBtn = jobModal.querySelector('.job-modal__close');
    const data = window.__timelineData || [];

    const openJob = (idx) => {
      const job = data[idx];
      if (!job) return;
      const d = job.details || {};

      titleEl.textContent = job.company;
      metaEl.textContent = `${job.role} · ${job.period}`;

      const facts = [];
      if (d.website) {
        const host = d.website.replace(/^https?:\/\//, '').replace(/\/$/, '');
        facts.push([
          'Site internet',
          `<a href="${d.website}" target="_blank" rel="noopener">${host} ↗</a>`,
        ]);
      }
      if (d.activity) facts.push(['Activité', d.activity]);
      if (d.sector) facts.push(['Secteur', d.sector]);
      if (d.position) facts.push(['Poste', d.position]);
      factsEl.innerHTML = facts
        .map(([k, v]) => `<div class="job-modal__fact"><dt>${k}</dt><dd>${v}</dd></div>`)
        .join('');

      actionsEl.innerHTML = (d.actions || [])
        .map((a) => `<li>${a}</li>`)
        .join('');

      if (typeof jobModal.showModal === 'function') {
        jobModal.showModal();
      } else {
        jobModal.setAttribute('open', '');
      }
    };

    const close = () => {
      if (typeof jobModal.close === 'function') jobModal.close();
      else jobModal.removeAttribute('open');
    };

    document.querySelectorAll('[data-job-index]').forEach((btn) => {
      btn.addEventListener('click', () => openJob(Number(btn.dataset.jobIndex)));
    });

    closeBtn?.addEventListener('click', close);
    jobModal.addEventListener('click', (e) => {
      if (e.target === jobModal) close();
    });
  }

  // Photo : flip au clic, retour à l'état initial quand le pointeur s'écarte.
  const photoFrame = document.querySelector('.photo-frame');
  if (photoFrame) {
    photoFrame.addEventListener('click', (event) => {
      if (!photoFrame.classList.contains('is-flipped')) {
        event.preventDefault();
        photoFrame.classList.add('is-flipped');
      }
    });
    photoFrame.addEventListener('mouseleave', () => {
      photoFrame.classList.remove('is-flipped');
    });
  }

  // Clics sur les chips de la stack → toast qui escalade.
  const chipMessages = [
    "Je sais que c'est satisfaisant mais c'est pas un bouton",
    'Toujours pas',
    'Non plus',
    'Bon ça suffit maintenant',
  ];
  let chipIndex = 0;
  let chipToast = null;
  let chipTimer = null;

  document.querySelectorAll('.chip').forEach((chip) => {
    chip.addEventListener('click', () => {
      const message = chipMessages[chipIndex % chipMessages.length];
      chipIndex += 1;

      if (!chipToast) {
        chipToast = document.createElement('div');
        chipToast.className = 'chip-toast';
        chipToast.setAttribute('role', 'status');
        document.body.appendChild(chipToast);
      }

      chipToast.textContent = message;
      chipToast.classList.remove('is-leaving');
      void chipToast.offsetWidth;
      chipToast.classList.add('is-visible');

      if (chipTimer) clearTimeout(chipTimer);
      chipTimer = setTimeout(() => {
        if (!chipToast) return;
        chipToast.classList.add('is-leaving');
        chipToast.classList.remove('is-visible');
        setTimeout(() => {
          if (chipToast) {
            chipToast.remove();
            chipToast = null;
          }
        }, 260);
      }, 2400);
    });
  });

  // Scroll jusqu'à la section perso → event de curiosité.
  const perso = document.getElementById('perso');
  if (perso && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            track('curiosity_activated');
            observer.disconnect();
          }
        });
      },
      { threshold: 0.35 }
    );
    observer.observe(perso);
  }
</script>

<style>
  /* HERO */
  .hero {
    padding: clamp(3rem, 7vw, 5.5rem) 0 clamp(2rem, 4vw, 3rem);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  h1 {
    font-size: clamp(3.2rem, 9vw, 6rem);
    margin-bottom: 1.25rem;
  }

  .hero__tagline {
    font-size: clamp(1rem, 1.7vw, 1.15rem);
    max-width: 48ch;
    color: var(--ink-soft);
    margin-bottom: 2rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .photo-frame {
    display: block;
    padding: 10px;
    transform: rotate(2.5deg);
    transition: transform 0.3s var(--ease);
    perspective: 1200px;
    cursor: pointer;
  }

  .photo-frame:hover,
  .photo-frame:focus-visible {
    transform: rotate(0deg);
  }

  .photo-flip {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1;
    transform-style: preserve-3d;
    transition: transform 0.6s var(--ease);
  }

  .photo-frame.is-flipped .photo-flip {
    transform: rotateY(180deg);
  }

  .photo-face {
    position: absolute;
    inset: 0;
    display: block;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border: var(--line);
    border-radius: 6px;
    overflow: hidden;
  }

  .photo-face--back {
    transform: rotateY(180deg);
    background: var(--yellow);
    display: grid;
    place-items: center;
    padding: 1.5rem;
    text-align: center;
  }

  .photo-face__text {
    font-size: clamp(1.1rem, 2.2vw, 1.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--ink);
  }

  .photo-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
  }

  /* METRICS */
  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(215px, 1fr));
    gap: 1.5rem;
    list-style: none;
  }

  .metric {
    padding: 1.6rem 1.4rem;
  }

  .metric__value {
    font-size: clamp(1.9rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    margin-bottom: 0.6rem;
  }

  .metric__label {
    font-weight: 700;
    font-size: 0.98rem;
    margin-bottom: 0.35rem;
  }

  .metric__detail {
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.45;
  }

  /* PROJECT */
  .projet__banner {
    padding: 10px;
    max-width: 640px;
    margin: 0 auto 2.5rem;
    transform: rotate(2.5deg);
    transition: transform 0.3s var(--ease);
  }

  .projet__banner:hover {
    transform: rotate(0deg);
  }

  .projet__banner img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 6px;
  }

  .projet__grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 1.5rem;
    align-items: start;
  }

  .projet__col {
    display: grid;
    gap: 1.5rem;
  }

  .projet-card {
    padding: 1.5rem 1.4rem;
  }

  .projet-card__kicker {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--yellow-deep);
    margin-bottom: 0.75rem;
  }

  .projet-card__kicker--ink {
    color: var(--yellow);
  }

  .projet-card__body {
    font-size: 1rem;
    line-height: 1.55;
  }

  .projet-card__goals,
  .projet-card__steps {
    list-style: none;
    display: grid;
    gap: 0.55rem;
    counter-reset: step;
  }

  .projet-card__goals li,
  .projet-card__steps li {
    position: relative;
    padding-left: 2rem;
    font-size: 0.95rem;
    line-height: 1.5;
    counter-increment: step;
  }

  .projet-card__goals li::before,
  .projet-card__steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0.05rem;
    width: 1.4rem;
    height: 1.4rem;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: var(--yellow);
    color: var(--ink);
    font-size: 0.72rem;
    font-weight: 800;
    border: 2px solid var(--ink);
  }

  .projet-card--workflow .projet-card__steps li::before {
    background: var(--yellow);
    border-color: var(--yellow);
  }

  .projet-card__intro {
    font-size: 0.95rem;
    margin-bottom: 1rem;
    opacity: 0.85;
  }

  .projet-card__outro {
    font-size: 0.9rem;
    line-height: 1.55;
    margin-top: 1.25rem;
    padding-top: 1.1rem;
    border-top: 2px dashed var(--yellow);
    opacity: 0.9;
  }

  .projet-card__outro strong {
    color: var(--yellow);
    opacity: 1;
  }

  .projet__cta {
    display: flex;
    justify-content: center;
    margin-top: 2.5rem;
  }

  @media (max-width: 780px) {
    .projet__grid {
      grid-template-columns: 1fr;
    }
  }

  :global(.chip-toast) {
    position: fixed;
    left: 50%;
    bottom: 1.75rem;
    transform: translate(-50%, 12px);
    z-index: 70;
    padding: 0.85rem 1.4rem;
    background: var(--ink);
    color: var(--white);
    border: var(--line);
    border-radius: 12px;
    box-shadow: 5px 5px 0 var(--yellow);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
    text-align: center;
    max-width: min(90vw, 32rem);
    opacity: 0;
    transition:
      opacity 0.22s var(--ease),
      transform 0.22s var(--ease);
    pointer-events: none;
  }

  :global(.chip-toast.is-visible) {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  :global(.chip-toast.is-leaving) {
    opacity: 0;
    transform: translate(-50%, 12px);
  }

  :global(.tracker) {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 60;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.6rem;
    pointer-events: none;
  }

  :global(.tracker__toast) {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    padding: 0.6rem 0.9rem;
    background: var(--ink);
    color: var(--white);
    border: var(--line);
    border-radius: 10px;
    box-shadow: 5px 5px 0 var(--yellow);
    animation: tracker-in 0.28s var(--ease);
  }

  :global(.tracker__toast.is-leaving) {
    animation: tracker-out 0.25s var(--ease) forwards;
  }

  :global(.tracker__label) {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #b5b5b5;
  }

  :global(.tracker__event) {
    font-family: ui-monospace, 'SF Mono', 'Cascadia Code', Menlo, Consolas, monospace;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  @keyframes tracker-in {
    from {
      opacity: 0;
      transform: translateX(12px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes tracker-out {
    to {
      opacity: 0;
      transform: translateX(12px);
    }
  }

  /* TIMELINE */
  .timeline {
    display: grid;
    gap: 1.5rem;
    list-style: none;
  }

  .job-item {
    list-style: none;
  }

  .job {
    padding: 1.5rem 1.6rem;
    width: 100%;
    display: block;
    text-align: left;
    font: inherit;
    color: inherit;
    cursor: pointer;
    position: relative;
  }

  .job__more {
    display: inline-block;
    margin-top: 0.85rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--yellow-deep);
  }

  /* JOB MODAL */
  :global(.job-modal) {
    padding: 0;
    border: var(--line);
    border-radius: 14px;
    background: var(--white);
    color: var(--ink);
    box-shadow: 8px 8px 0 var(--ink);
    max-width: min(640px, 92vw);
    max-height: 90vh;
    width: 100%;
    margin: auto;
    position: fixed;
    inset: 0;
